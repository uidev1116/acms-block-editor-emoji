{
    "name": "uidev1116/acms-block-editor-emoji",
    "description": "Adds emoji suggestions and an emoji picker to the a-blog cms block editor.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "uidev1116",
            "email": "uidev1116@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "ext-zip": "*",
        "ablogcms/testing-framework": "3.2.*",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Acms\\Plugins\\BlockEditorEmoji\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acms\\Plugins\\BlockEditorEmoji\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/phpcs --standard=phpcs.xml.dist",
        "format": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "package": "@php scripts/package.php",
        "version:set": "@php scripts/version.php",
        "release:patch": "@php scripts/release.php patch",
        "release:minor": "@php scripts/release.php minor",
        "release:major": "@php scripts/release.php major",
        "coverage": "php -d pcov.enabled=1 -d pcov.directory=/var/www/html/extension/plugins/BlockEditorEmoji vendor/bin/phpunit -c phpunit.coverage.xml.dist --coverage-text"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpcsstandards/composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "homepage": "https://github.com/uidev1116/acms-block-editor-emoji"
}
