{
  "name": "acms-block-editor-emoji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm run build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/copy-emojibase.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ablogcms/i18n": "3.2.37",
    "@ablogcms/plugins": "3.2.37",
    "frimousse": "^0.4.0"
  },
  "devDependencies": {
    "@ablogcms/block-editor": "3.2.37",
    "@ablogcms/components": "3.2.37",
    "@ablogcms/types": "3.2.37",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,yml,yaml}": "prettier --write"
  },
  "volta": {
    "node": "24.22.0"
  }
}
